{
  "name": "online-book-firestore-rules-tests",
  "private": true,
  "scripts": {
    "audit:community-attachments": "node scripts/audit_community_attachments.cjs",
    "admin:set-claim": "node scripts/set_admin_claim.cjs",
    "test:admin-claim-script": "mocha test/set_admin_claim_script.test.cjs --timeout 30000",
    "test:audit-community-attachments": "mocha test/community_attachment_audit.test.cjs --timeout 30000",
    "test:rules": "mocha test/firestore.rules.test.cjs --timeout 30000",
    "test:firestore-rules": "firebase emulators:exec --project demo-vbook-sec-004b --only firestore \"npm run test:rules\"",
    "test:sec-004c": "firebase emulators:exec --project demo-vbook-sec-004c --only firestore \"npm run test:rules && npm run test:audit-community-attachments\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^15.26.0",
    "mocha": "^11.7.5"
  }
}
