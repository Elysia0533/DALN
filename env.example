# Copy this file to .env and replace placeholders with values from Firebase Console.
# Keep .env local only; it is ignored by git.
# Android Gradle reads the Drive and Firebase values automatically. Other
# platforms should run Flutter with --dart-define-from-file=.env.

GOOGLE_DRIVE_API_KEY=your_restricted_google_drive_api_key

FIREBASE_API_KEY=your_firebase_web_or_android_api_key
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Optional for web/analytics/iOS builds.
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_MEASUREMENT_ID=
FIREBASE_IOS_BUNDLE_ID=
